# Email delivery for the "Get in Touch" form (https://resend.com)
# Create an API key, verify your sending domain, then set these in Vercel
# Project Settings -> Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Sahipa Website <website@sahipa.com>"

# Where enquiries are delivered.
CONTACT_TO_EMAIL=jollie@sahipa.com
